<h2>All Artists</h2>

<% @artist_spaces.each do |artist_space| %>
  <p><%= link_to(artist_space.artist_name, artist_space_path(artist_space)) %></p>

  <% unless current_user.artist_spaces.exists?(artist_space.id) %>
    <%= button_to "Add to dashboard",
      artist_space_membership_path(artist_space), method: :post %>
  <% end %>
<% end %>

<%= link_to("Create new Artist Space", new_artist_space_path) %>
