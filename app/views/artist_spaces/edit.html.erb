<h2>Edit Artist</h2>

<%= simple_form_for @artist_space do |f| %>
  <%= f.input :artist_name %>
  <%= f.input :bio %>
  <%= f.input :social_media_url %>
  <%= f.input :website_url %>
  <%= f.submit "Update artist" %>
<% end %>

<%= link_to("Go back to artist space", artist_space_path(@artist_space)) %>
