<h1>Mein Dashboard</h1>
<p>E-Mail: <%= @user.email %></p>

<% @artist_spaces.each do |artist_space| %>
  <div>
    <h2><%= link_to artist_space.artist_name, artist_space_path(artist_space) %></h2>

    <%= button_to "Entfernen",
        artist_space_membership_path(artist_space),
        method: :delete %>
  </div>
<% end %>

<%= link_to "Artist Spaces entdecken", artist_spaces_path %>

<%= link_to "Profil bearbeiten", edit_user_registration_path %>
